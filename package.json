    "replay": "tsx scripts/replay-history.ts",
    "demo:rebuild": "tsx scripts/rebuild-demo-state.ts",
    "attacks:generate": "tsx --env-file=.env scripts/generate-attacks.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
