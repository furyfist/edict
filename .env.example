# ---------------------------------------------------------------------------
# Database — required. Every surface reads from it.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edict?schema=public"

# ---------------------------------------------------------------------------
# Prava — the only payment boundary.
#
# Leave PRAVA_MODE=mock to run the whole system with no external dependency.
# The mock adapter sits behind the same interface as the real one and is
# retained in the repository through the demo as a live fallback.
# ---------------------------------------------------------------------------
PRAVA_MODE="mock"
PRAVA_API_BASE="https://sandbox.api.prava.com"
PRAVA_API_KEY=""

# ---------------------------------------------------------------------------
# Model — advisory only. The agent proposes; it never authorizes.
#
# Leave AGENT_MODE=stub to run on the deterministic stub proposer, which is
# also retained through the demo as a live fallback.
# ---------------------------------------------------------------------------
AGENT_MODE="stub"
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-sonnet-4-5"

# ---------------------------------------------------------------------------
# Scheduler — shared secret the cron presents to the tick endpoint.
# ---------------------------------------------------------------------------
TICK_SECRET="local-dev-secret"
