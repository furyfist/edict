# Database — Postgres only. Two URLs on Supabase (or any split-mode pooler):
#   DATABASE_URL — transaction pooler (port 6543) for runtime queries. Never a
#     session pooler; its connection cap is too low for Next.js dev.
#   DIRECT_URL — session pooler (port 5432) for `prisma db push` / `migrate`.
# On plain Postgres, set both to the same value.
# Percent-encode URI-reserved characters in the password (@ -> %40).
DATABASE_URL="postgresql://user:password@pooler-host:6543/dbname?pgbouncer=true&connection_limit=20"
DIRECT_URL="postgresql://user:password@pooler-host:5432/dbname"

# Prava — sandbox only. Secret key is server-side; all calls go through
# lib/prava. Owner: WS-B.
PRAVA_SECRET_KEY="sk_test_..."
PRAVA_PUBLISHABLE_KEY="pk_test_..."
PRAVA_API_BASE="https://sandbox.api.prava.space"

# Agent — the LLM proposes; it never authorizes or executes. Owner: WS-C.
OPENAI_API_KEY="sk-..."
# Must support strict json_schema structured outputs.
OPENAI_MODEL="gpt-4o"
# Optional. Any OpenAI-compatible provider, e.g. Groq:
# "https://api.groq.com/openai/v1" with OPENAI_MODEL="openai/gpt-oss-120b".
OPENAI_BASE_URL=""

# Receipts — Ed25519 ledger signing key, base64 PKCS8. Generate with
# `npm run keygen`. Server-side only. If unset, entries are still written but
# marked UNATTESTED. Verify this is set on the deployed build before a demo.
RECEIPT_SIGNING_KEY=""

# Demo environment
# Guards the tick endpoint and demo-only routes.
DEMO_ADMIN_TOKEN="change-me"
# Guards the tick endpoint for Vercel Cron's GET requests — set the same value
# as a Vercel project env var.
CRON_SECRET="change-me"
