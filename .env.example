# Database — one environment, one database. Postgres only, no SQLite.
#
# TWO connection strings if you are on Supabase (or any provider whose pooler
# separates transaction and session modes) — see prisma/schema.prisma:
#
#   DATABASE_URL — the pooled connection every normal query uses at runtime.
#   On Supabase this is the "Transaction" mode pooler URI (port 6543), with
#   ?pgbouncer=true&connection_limit=20 appended. Do NOT point this at a
#   session-mode pooler — that mode caps total connections low (e.g. 15 on
#   Supabase), and Next.js dev mode alone can exceed it.
#
#   Why 20: a modest safety margin, not a fix for anything. It once mattered a
#   great deal — the Vendors page issued about forty small queries per render
#   and a narrow pool queued them into waves. Measured on the production build,
#   warmed, against the same database:
#
#       42 queries, pool 5   ~10.2s      7 queries, pool 20   ~2.7s
#       42 queries, pool 20   ~5.6s      7 queries, pool  5   ~2.9s
#
#   Grouping the reads did the real work; the pool size is now worth about
#   0.2s. 20 is kept because it is free and harmless against the TRANSACTION
#   pooler, which allows far more clients than the session pooler's low cap —
#   which is what the warning above is really about. Do not read this number as
#   load-bearing.
#
#   DIRECT_URL — used only for `prisma db push` / `migrate`, which need a
#   session-level advisory lock that transaction-mode pooling does not
#   support. On Supabase this is the "Session" mode pooler URI (port 5432).
#   Against a plain (non-pooled) Postgres host, set both to the same value.
#
# If your password contains "@", ":", or other URI-reserved characters,
# percent-encode them (@ -> %40) or the driver will misparse the string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@pooler-host:6543/dbname?pgbouncer=true&connection_limit=20"
DIRECT_URL="postgresql://user:password@pooler-host:5432/dbname"

# ---------------------------------------------------------------------------
# Prava — sandbox only. The secret key is server-side and must never reach
# the browser. All Prava calls go through lib/prava, the single payment
# boundary. Owner: WS-B.
# ---------------------------------------------------------------------------
PRAVA_SECRET_KEY="sk_test_..."
PRAVA_PUBLISHABLE_KEY="pk_test_..."
PRAVA_API_BASE="https://sandbox.api.prava.space"

# ---------------------------------------------------------------------------
# Agent — the LLM proposes. It never authorizes and never executes.
# Temperature is fixed at 0 in code, not here. Owner: WS-C.
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
# Must support structured outputs (json_schema with strict: true) — both the
# proposer and the policy compiler depend on it.
OPENAI_MODEL="gpt-4o"
# Optional. Any OpenAI-compatible provider works without code changes.
# Groq example: OPENAI_BASE_URL="https://api.groq.com/openai/v1" with
# OPENAI_MODEL="openai/gpt-oss-120b" (note: llama-3.3-70b does NOT support
# strict json_schema and will 400).
OPENAI_BASE_URL=""

# ---------------------------------------------------------------------------
# Receipts — the ledger's signing key. Ed25519, base64 PKCS8.
#
# Generate one with `npm run keygen`. Server-side only; it never reaches the
# browser and never appears in an exported bundle — only the public half does.
#
# If this is unset the system still runs and still writes every ledger entry.
# Entries are marked UNATTESTED everywhere they are shown, and the offline
# verifier reports them as such. Signing can never block a write: appendEntry
# runs after a charge may already have succeeded.
#
# CHECK THIS IS SET ON THE DEPLOYED BUILD BEFORE A DEMO. A missing key turns
# the whole verification beat into a row of "unattested" badges.
# ---------------------------------------------------------------------------
RECEIPT_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Demo environment
# ---------------------------------------------------------------------------
# Guards the tick endpoint and the demo-only routes.
DEMO_ADMIN_TOKEN="change-me"

# Guards the tick endpoint specifically for Vercel Cron's GET requests.
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET` once
# the same value is set as an env var on the project — set it there too.
CRON_SECRET="change-me"
