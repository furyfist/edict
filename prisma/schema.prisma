// Edict — data model
//
// Source of truth: docs/engineering_decisions.md
// Schema is frozen after M1 except for additive columns.
// Owner: WS-A. Announce all changes before committing.
//
// Money is always an Int number of cents. Never Float, never Decimal.
// Timestamps ending in `At` are wall clock. Fields named `clockAt` or
// `cycleStart` follow the demo clock — see lib/clock.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for normal queries — see .env for why this must be the
  // transaction pooler, not the session pooler.
  url       = env("DATABASE_URL")
  // Session-mode connection used only for schema operations (db push,
  // migrate), which need a session-level advisory lock that PgBouncer
  // transaction mode does not support. Prisma selects this automatically for
  // those commands; ordinary queries always use `url` above.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Evidence side — what the agent observes
// ---------------------------------------------------------------------------

enum Frequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  YEARLY
}

model Vendor {
  id       String @id @default(uuid())
  name     String @unique
  category String

  /// Fictional placeholder. No real personal data is ever stored.
  billingContact String

  seats           Seat[]
  usageRecords    UsageRecord[]
  renewals        Renewal[]
  inboundMessages InboundMessage[]

  createdAt DateTime @default(now())

  @@index([category])
}

model Seat {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  email      String
  assignedAt DateTime

  usageRecords UsageRecord[]

  @@unique([vendorId, email])
  @@index([vendorId])
}

/// One row per seat per day. Absence of rows is meaningful: it means usage is
/// unknown, which the engine treats as REQUIRE_APPROVAL rather than as zero.
model UsageRecord {
  id String @id @default(uuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  seatId   String
  seat     Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)

  /// Date on the demo clock.
  day      DateTime
  loggedIn Boolean

  @@unique([seatId, day])
  @@index([vendorId, day])
}

model Renewal {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Identifies the billing cycle. Half of the tick idempotency key.
  cycleStart DateTime
  dueDate    DateTime

  amountCents Int
  currency    String    @default("USD")
  frequency   Frequency

  @@unique([vendorId, cycleStart])
  @@index([dueDate])
}

/// Untrusted vendor-authored text that reaches the agent's context.
/// This is the prompt-injection surface, modelled deliberately.
model InboundMessage {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  receivedAt DateTime
  fromAddr   String
  subject    String
  body       String

  /// True for messages planted through the attack console.
  injected Boolean @default(false)

  @@index([vendorId, receivedAt])
}

// ---------------------------------------------------------------------------
// Authority side — where power comes from
// ---------------------------------------------------------------------------

enum PolicyStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum Effect {
  ALLOW_AUTO
  REQUIRE_APPROVAL
  DENY
}

enum ScopeKind {
  VENDOR
  CATEGORY
  ANY
}

/// Policies are immutable. Editing produces a new version; activating a new
/// version never rewrites history and never modifies an existing mandate.
model PolicyVersion {
  id      String @id @default(uuid())
  version Int    @unique

  /// Exactly what the user typed. Never normalized or rewritten.
  englishText String
  status      PolicyStatus @default(DRAFT)

  compiledAt  DateTime  @default(now())
  /// Null while the policy is still an inert draft awaiting confirmation.
  activatedAt DateTime?

  rules     PolicyRule[]
  ticks     Tick[]
  approvals Approval[]

  @@index([status])
}

model PolicyRule {
  id              String        @id @default(uuid())
  policyVersionId String
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  ordinal Int
  effect  Effect

  scopeKind     ScopeKind
  scopeVendorId String?
  scopeCategory String?

  /// Required on ALLOW_AUTO rules. Unbounded autonomy is uncompilable.
  maxAmountCents    Int?
  minActiveSeatPct  Int?
  frequency         Frequency?
  renewalWithinDays Int?

  /// The span of the user's English this rule was derived from. Must appear
  /// verbatim in englishText. A rule with no textual origin is rejected.
  sourceFragment String

  @@unique([policyVersionId, ordinal])
  @@index([policyVersionId])
}

enum MandateStatus {
  PENDING
  ACTIVE
  PAUSED
  CONSUMED
  CANCELLED
  EXPIRED
}

/// A local mirror of a Prava mandate. Prava owns the truth; this is a cache
/// refreshed on every tick. Never treat these values as authoritative.
model Mandate {
  id String @id @default(uuid())

  /// Identifier issued by Prava.
  pravaMandateId String @unique
  vendorId       String @unique

  status MandateStatus

  /// Per-charge ceiling. Enforced in the tokenized credential, not by us.
  capCents       Int
  remainingCents Int
  frequency      Frequency

  expiresAt   DateTime?
  refreshedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([status])
}

enum ApprovalType {
  /// Within existing mandate authority. Approved in-app, no passkey.
  POLICY_EXCEPTION
  /// Exceeds mandate authority. Requires a fresh passkey ceremony.
  CEILING_RAISE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// An approval freezes the proposal, the evidence, and the policy version it was
/// raised under. Expired approvals are never revived — the evidence that
/// justified them is stale by definition.
model Approval {
  id     String         @id @default(uuid())
  type   ApprovalType
  status ApprovalStatus @default(PENDING)

  vendorId   String
  renewalId  String
  cycleStart DateTime

  /// Frozen snapshots. Json because they are records, not queryable state.
  proposalSnapshot Json
  evidenceSnapshot Json

  policyVersionId String
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id])
  ruleId          String

  amountCents Int

  /// 24 hours from creation.
  expiresAt  DateTime
  approverId String?
  approvedAt DateTime?
  rejectedAt DateTime?
  /// Set only for CEILING_RAISE. In-app approval never creates authority.
  passkeyAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status, expiresAt])
  @@index([vendorId, cycleStart])
}

// ---------------------------------------------------------------------------
// Accountability side — the record
// ---------------------------------------------------------------------------

enum Action {
  RENEW_AS_IS
  RENEW_REDUCED
  PAUSE
  CANCEL
  ESCALATE
}

enum Outcome {
  EXECUTED
  ESCALATED
  REFUSED
  FAILED
  HALTED
}

enum RefusalCode {
  POLICY_DENIED
  MALFORMED_PROPOSAL
  INVALID_ACTION
  NETWORK_DECLINE
  MANDATE_INACTIVE
  OUTSIDE_AUTHORITY
  UNSUPPORTED_CURRENCY
  APPROVAL_REJECTED
  APPROVAL_EXPIRED
}

enum HaltReason {
  KILL_SWITCH
  NO_POLICY
  AGENT_UNAVAILABLE
  ADAPTER_UNAVAILABLE
  LOCK_HELD
}

enum TickStatus {
  RUNNING
  COMPLETED
  HALTED
}

/// Why a tick ran. Operational work, or the gauntlet under attack.
///
/// ---------------------------------------------------------------------------
/// ONE CHAIN, TWO VIEWS — and why this lives on Tick and not on LedgerEntry.
///
/// A separate adversarial ledger was rejected: it would be a demo-only path,
/// and it would exempt every attack from the tamper-evidence guarantee that
/// makes the record worth anything. Same writer, same chain, same schema.
///
/// But the tag itself must NOT be on LedgerEntry, because a ledger entry's
/// contract projection is what gets signed. Adding a field there would change
/// every signed payload and invalidate every receipt ever issued — the ledger
/// would read CHAIN COMPROMISED on stage for a schema change nobody attacked.
///
/// It belongs here anyway. The context is a property of the RUN, not of the
/// decision: the engine adjudicated identically either way, which is precisely
/// the claim the gauntlet exists to make. Views filter by joining; the chain
/// does not filter at all, so an attacker cannot hide an edit between the two.
/// ---------------------------------------------------------------------------
enum RunContext {
  OPERATIONAL
  ADVERSARIAL
}

model Tick {
  id String @id @default(uuid())

  /// Wall clock, operational only.
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// The time the system believed it was. Demo clock.
  clockAt    DateTime

  /// Pinned once at tick start. A policy edit mid-tick cannot affect
  /// decisions already in flight.
  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  status     TickStatus  @default(RUNNING)
  haltReason HaltReason?

  /// Operational by default. The gauntlet sets ADVERSARIAL; entries inherit it
  /// through this relation rather than carrying a copy.
  runContext RunContext @default(OPERATIONAL)

  /// Set on gauntlet ticks: which frozen corpus entry was being delivered.
  /// Null on operational ticks.
  attackId String?

  entries LedgerEntry[]

  @@index([startedAt])
  @@index([runContext, startedAt])
}

/// APPEND-ONLY. lib/ledger exposes no update and no delete path. A correction is
/// a new entry pointing at the one it corrects via correctsEntryId.
///
/// Never stored here: card numbers, payment tokens, passkey material, Prava
/// secret keys, raw model prompts, or real personal data.
model LedgerEntry {
  id     String @id @default(uuid())
  tickId String
  tick   Tick   @relation(fields: [tickId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  /// Demo clock at decision time.
  clockAt   DateTime

  vendorId   String
  vendorName String
  renewalId  String
  cycleStart DateTime

  proposedAction      Action
  proposedAmountCents Int

  outcome     Outcome
  refusalCode RefusalCode?
  haltReason  HaltReason?

  /// The four attribution fields. Separate because the separation is the
  /// security property: the decider is not the authorizer.
  decidedBy    Json?
  authorizedBy Json?
  executedBy   Json?

  amountCents     Int
  currency        String @default("USD")
  financialImpact Json

  /// Frozen at decision time. Shows what was known then.
  evidence Json

  /// Template-rendered from structured data. Never written by a model.
  explanation    String
  counterfactual String
  alternative    Json?

  /// The model's own words, kept in their own field so the interface can render
  /// them in a separate labeled region.
  agentRationale String?

  correctsEntryId String?
  error           Json?

  /// ------------------------------------------------------------------------
  /// RECEIPT — what makes "append-only" a mechanism rather than a promise.
  ///
  /// Issued at insert time over the entry's CONTRACT projection (the shape
  /// lib/ledger/read.ts reconstructs), never over this row. See
  /// lib/ledger/record.ts for why that distinction is load-bearing.
  ///
  /// All nullable, because entries written before receipts existed are
  /// UNATTESTED rather than invalid — absence of a signature is not a forgery.
  /// ------------------------------------------------------------------------

  /// SHA-256 over the canonical signed payload. The next entry links to this.
  receiptDigest     String?
  /// The predecessor's digest. All zeroes for the first entry in a chain.
  receiptPrevDigest String?
  /// Base64 Ed25519. Null when no signing key was configured at write time.
  receiptSignature  String?
  receiptKeyId      String?
  receiptCanonVersion String?

  @@unique([renewalId, cycleStart, tickId])
  @@index([createdAt])
  @@index([outcome])
  @@index([vendorId])
}

/// THE MOCK PROVIDER'S OWN BOOK.
///
/// Written only by the mock payment adapter, never by lib/ledger and never by
/// anything else. It exists so reconciliation has a real second book to check
/// against when no provider is connected — otherwise the offline demo could
/// only ever compare our ledger with itself, which proves nothing.
///
/// This is not a demo-only code path. The mock is a full implementation of the
/// payment boundary that ships as the documented fallback; this is its
/// storage, exactly as Prava's own database is the real adapter's.
model MockCharge {
  id String @id @default(uuid())

  chargeId  String @unique
  mandateId String

  amountCents Int
  currency    String @default("USD")
  status      String

  /// Our idempotency key, echoed back the way the real provider echoes
  /// `reference`. The join key for two-sided reconciliation.
  reference String?

  createdAt DateTime @default(now())

  @@index([mandateId, createdAt])
}

// ---------------------------------------------------------------------------
// Proof plane — claims the system makes ABOUT its own record
// ---------------------------------------------------------------------------

/// The claim types. One table, not three, because they are one object: a
/// signed, canonical, offline-verifiable statement anchored to a ledger head.
/// Adding a type must never mean adding a table, a signer, or a verifier.
enum ClaimType {
  /// A human saw what a policy would do, then granted it. (M1)
  ACTIVATION
  /// The books balance against the payment network's own record. (M2)
  RECONCILIATION
  /// N attacks ran, none executed outside authority. (M3)
  ADVERSARIAL
}

/// A signed claim about the record, as opposed to a record of an action.
///
/// A ledger entry says "this happened". A claim says something ABOUT a set of
/// entries — that a preview preceded them, that nothing is missing from them,
/// that an adversary could not add to them. Both are signed the same way by the
/// same key, and the same offline verifier reads both.
///
/// ANCHORING is what makes claims compose: every claim names the ledger head it
/// was made against, and that head is inside the signature. Tamper with any
/// entry and both the chain and every downstream claim break together.
model Claim {
  id   String    @id @default(uuid())
  type ClaimType

  createdAt DateTime @default(now())
  /// Demo clock at the moment the claim was made.
  clockAt   DateTime

  /// Digest of the last ledger entry when this claim was made, or all zeroes
  /// for a claim made against an empty ledger.
  ledgerHead String

  /// The claim's body. Json because it is a record, not queryable state.
  subject Json

  /// Set on ACTIVATION claims. Not a relation: a claim must survive as an
  /// artifact even if what it refers to is later removed.
  policyVersionId String?

  /// Receipt — identical shape and identical meaning to LedgerEntry's.
  receiptDigest       String?
  receiptPrevDigest   String?
  receiptSignature    String?
  receiptKeyId        String?
  receiptCanonVersion String?

  @@index([type, createdAt])
  @@index([policyVersionId])
}

// ---------------------------------------------------------------------------
// System state — one row, id "singleton"
// ---------------------------------------------------------------------------

/// The demo clock, the halt flag, and the single-flight lock.
///
/// System time is a database value, not wall time. Every component reads it.
/// This is what makes the overnight run reproducible and the year speed-run
/// free, and it is why no component may call Date.now() for domain logic.
model SystemState {
  id String @id @default("singleton")

  /// The time the system believes it is.
  demoClock DateTime

  /// When engaged, every mandate is paused and the next tick refuses to run.
  killSwitchEngaged Boolean   @default(false)
  killSwitchAt      DateTime?

  /// Single-flight lock. One tick at a time, no parallelism.
  tickLockHeldBy String?
  tickLockAt     DateTime?

  updatedAt DateTime @updatedAt
}
